{
  "expo": {
    "name": "Echt",
    "slug": "echt",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "app.echt.dating",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "favicon": "./assets/favicon.png",
      "output": "single"
    },
    "scheme": "echt",
    "backgroundColor": "#F6F1EE",
    "plugins": [
      "expo-router",
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Echt nutzt deinen ungefähren Standort, um dir Menschen in deiner Nähe zu zeigen. Beim Date-Check sieht deine Vertrauensperson, wo du gerade bist."
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Echt braucht Zugriff auf deine Fotos, damit du Bilder für dein Profil auswählen kannst.",
          "cameraPermission": false,
          "microphonePermission": false
        }
      ],
      "expo-notifications"
    ],
    "owner": "malcolmz",
    "extra": {
      "eas": {
        "projectId": "8f81d902-05a7-454e-bca3-d74869557aef"
      }
    }
  }
}
